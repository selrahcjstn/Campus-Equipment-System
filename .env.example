# Copy to .env (ignored by Git). Set a privately generated random key.
# Process environment variables override this file. Values are not interpolated.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Leave blank to use the existing db.sqlite3. Use a separate absolute filename
# for demonstration data; never seed the working database.
DJANGO_DATABASE_PATH=
